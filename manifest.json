{
  "manifest_version": 3,
  "name": "Important Links",
  "version": "2.0.0",
  "description": "Save, find, and open the links that matter. Private, local-only, fast.",
  "action": {
    "default_title": "Important Links",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "favicon"],
  "minimum_chrome_version": "104"
}
